# Rust workspace (binaries ship: lockfile is committed intentionally)
# NOTE: no `Cargo.lock` ignore — tuilab builds tuilab/tuilab-mcp binaries.
/tuilab/target/
**/target/
**/*.rs.bk

# TUI Lab test artifacts (never commit)
reports/
tuilab/*.log
**/snapshots/*.new
**/snapshots/*.actual.*
tuilab/tests/**/*.log
*.pty.log

# Recorder output drafts
/recordings/*.draft.yaml

# SDK build artifacts (paths relative to repo root)
tuilab/sdks/python/dist/
tuilab/sdks/python/dist-wheels/
tuilab/sdks/python/src/tuilab/_bin/
tuilab/sdks/python/*.egg-info/
tuilab/sdks/python/uv.lock
tuilab/sdks/python/tests/snapshots/
tuilab/sdks/javascript/dist/
tuilab/sdks/javascript/node_modules/
tuilab/sdks/npm-cli/dist/
tuilab/sdks/npm-cli/platforms/*/tuilab*
web-guide/dist/
web-guide/node_modules/
.venv/
.pytest_cache/
__pycache__/
*.py[cod]

# Exported chat dumps (design source; distilled into docs/, never committed)
*.mhtml

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.orig

# Local overrides (checked-in example is tuilab.example.yaml)
tuilab.local.yaml
.env
.agents/
.claude/
target/